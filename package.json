{
  "name": "picontrol",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Control plane UI housing and CLI for the Pi ecosystem (pigateway, pimatrix, pitube, pilight, pivoice)",
  "bin": {
    "picontrol": "./bin/picontrol.mjs"
  },
  "scripts": {
    "build:ui": "npm --prefix ui run build",
    "build:cli": "tsc -p tsconfig.json",
    "build": "npm run build:cli && npm run build:ui",
    "cli": "node bin/picontrol.mjs",
    "dev:ui": "npm --prefix ui run dev",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
