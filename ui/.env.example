# ==============================================================================
# picontrol UI - Environment Configuration
# ==============================================================================
# Build-time variables for the frontend Vite build.
#
# Default (Recommended for Nginx deployment):
# Leave VITE_GATEWAY_URL empty or unset so the UI automatically connects to the
# SAME HOST and origin that the static build is served from (e.g. /api/...).
# ==============================================================================

# Target Pi Gateway base URL:
# - Leave empty ("") for same-origin (Nginx reverse proxy on the church domain)
# - Or set to an explicit URL (e.g. http://192.168.1.50:3100) for development/cross-host testing
VITE_GATEWAY_URL=

# Optional dedicated service overrides (defaults route via /api/v1/* on gateway):
# VITE_PITUBE_URL=
# VITE_PILIGHT_URL=
# VITE_PIVOICE_URL=
# VITE_PIRADIO_URL=
# VITE_PISOUND_API_URL=
